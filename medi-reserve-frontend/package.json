{
  "name": "medi-reserve-frontend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "gen-api": "npm run gen:patient && npm run gen:doctor && npm run gen:admin && npm run gen:websocket",
    "gen:patient": "swagger-typescript-api generate -p ./docs/患者端_OpenAPI.json -o ./src/api/patient -n patientApi.ts --axios",
    "gen:doctor": "swagger-typescript-api generate -p ./docs/医生端_OpenAPI.json -o ./src/api/doctor -n doctorApi.ts --axios",
    "gen:admin": "swagger-typescript-api generate -p ./docs/管理端_OpenAPI.json -o ./src/api/admin -n adminApi.ts --axios",
    "gen:websocket": "swagger-typescript-api generate -p \"./docs/WebSocket 服务_OpenAPI.json\" -o ./src/api/websocket -n websocketApi.ts --axios"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "@stomp/stompjs": "^7.3.0",
    "@vueuse/core": "^14.3.0",
    "ali-oss": "^6.23.0",
    "axios": "^1.18.1",
    "echarts": "^6.1.0",
    "element-plus": "^2.14.3",
    "pinia": "^4.0.2",
    "sockjs-client": "^1.6.1",
    "vue": "^3.5.40",
    "vue-router": "^5.2.0"
  },
  "devDependencies": {
    "@tsconfig/node24": "^24.0.4",
    "@types/node": "^24.13.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/tsconfig": "^0.9.1",
    "npm-run-all2": "^9.0.2",
    "openapi-typescript": "^7.13.0",
    "swagger-typescript-api": "^13.12.6",
    "typescript": "^5.4.0",
    "vite": "^8.2.0",
    "vite-plugin-vue-devtools": "^8.1.5",
    "vue-tsc": "^3.3.7"
  },
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  }
}
